NEXT_PUBLIC_APP_URL="http://localhost:3001"
BETTER_AUTH_URL="http://localhost:3001"
BETTER_AUTH_SECRET="replace-with-long-random-secret"

DATABASE_URL="postgresql://webport:webport@localhost:5433/webportv2?schema=public"

ADMIN_EMAIL="rapeepongapic@gmail.com"

PASSKEY_RP_ID="localhost"
PASSKEY_RP_NAME="WebPort v2"

# Cloudflare R2 (CMS media — production). If unset, uploads go to public/uploads locally.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="webport"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Optional: Groq for CMS Quick Chat (preferred when set)
GROQ_API_KEY=""
GROQ_CMS_MODEL="openai/gpt-oss-120b"

# Optional: separate Groq key/model for public site chat
GROQ_SITE_API_KEY=""
GROQ_SITE_MODEL="openai/gpt-oss-120b"
GOOGLE_GENERATIVE_AI_API_KEY=""

# Local Ollama fallback for CMS + public site chat (used when Groq keys are empty)
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.2"

# Gmail SMTP (required to deliver OTP to email)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="ShiftBOi CMS <your-gmail@gmail.com>"
